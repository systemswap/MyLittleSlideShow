<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MyLittleSlideShow</RootNamespace>
    <AssemblyName>MyLittleSlideShow</AssemblyName>

    <!-- Avalonia -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <Version>2.1.1.0</Version>
    <FileVersion>2.1.1.0</FileVersion>
    <AssemblyVersion>2.1.1.0</AssemblyVersion>
    <Company>MTS-Solutions.de</Company>
    <Product>MyLittleSlideShow</Product>

    <!-- Kein RuntimeIdentifier hier fest verdrahten: wird beim publish uebergeben -->
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.23" Condition="'$(Configuration)' == 'Debug'" />

    <!-- Keine Build-Telemetrie: Avalonia.BuildServices kommt transitiv mit
         Avalonia und sendet bei jedem Build Projektname, Zielplattform und
         Avalonia-Version an av-build-tel-api-v1.avaloniaui.net. Einen
         dokumentierten Abschalter hat das Paket nicht; mit ExcludeAssets
         wird sein MSBuild-Target gar nicht erst eingebunden. Die Version muss
         der von Avalonia geforderten entsprechen (sonst NU1605). -->
    <PackageReference Include="Avalonia.BuildServices" Version="11.3.2"
                      ExcludeAssets="all" PrivateAssets="all" />

    <!-- Avalonia.X11 zieht Tmds.DBus.Protocol 0.21.2 herein; 0.21.3 schliesst
         GHSA-xrw6-gwf8-vvr9. Explizit setzen hebt die transitive Version an. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />

    <!-- Bildverarbeitung (Dekodieren, Skalieren, Drehen, Kodieren). SkiaSharp
         kommt ohnehin mit Avalonia.Skia; die Version muss exakt der von
         Avalonia entsprechen, sonst passen verwaltete und native Teile nicht
         zusammen. Bei einem Avalonia-Update hier mitziehen. MIT-Lizenz. -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />

    <!-- EXIF-Anzeige im Info-Fenster. Apache-2.0 (XmpCore: BSD-3). -->
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Infos\Changelog.txt" />
    <EmbeddedResource Include="Infos\HiddenOptions.txt" />

    <!-- Lizenztexte im Programm (Infos > Lizenzen), damit auch die einzelne
         EXE alles mitbringt, was die Lizenzen der Fremdbestandteile verlangen. -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="MyLittleSlideShow.Licenses.LICENSE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="MyLittleSlideShow.Licenses.THIRD-PARTY-NOTICES.md" />
    <EmbeddedResource Include="..\..\licenses\*.txt" LogicalName="MyLittleSlideShow.Licenses.%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Beim Single-File-Publish wandert normalerweise alles in die eine EXE.
    Mit -p:KeepExternalLibsSeparate=true bleiben die Fremdbibliotheken fuer
    EXIF (MetadataExtractor, XmpCore) als eigene DLLs daneben liegen, damit
    sie separat austauschbar sind. Die Publish-Skripte setzen das.
  -->
  <Target Name="KeepExternalLibsOutOfBundle"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(KeepExternalLibsSeparate)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)">
        <ExcludeFromSingleFile Condition="'%(Filename)' == 'MetadataExtractor' or '%(Filename)' == 'XmpCore'">true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
