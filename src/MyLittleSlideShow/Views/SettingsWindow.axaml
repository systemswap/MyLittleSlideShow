<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:MyLittleSlideShow.Localization"
        xmlns:v="using:MyLittleSlideShow.Views"
        x:Class="MyLittleSlideShow.Views.SettingsWindow"
        Title="{l:T 'MyLittleSlideShow Einstellungen'}"
        Width="980"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontSize="12"
        Background="{DynamicResource Fine.WindowBackground}"
        Foreground="{DynamicResource Fine.TextPrimary}"
        Icon="/Assets/My_Icon.ico">

  <Window.Styles>
    <StyleInclude Source="/Themes/FineTheme.axaml" />
    <StyleInclude Source="/Themes/DonateButton.axaml" />

    <!-- In der schmaleren Spalte etwas kuerzere Regler -->
    <Style Selector="Slider">
      <Setter Property="Width" Value="130" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Kopfzeile -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="24,16,24,8">
      <Image Source="/Assets/Images/MyIcon.png" Width="30" Height="30"
             VerticalAlignment="Center"
             RenderOptions.BitmapInterpolationMode="HighQuality" />
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
        <TextBlock Text="{l:T 'Einstellungen'}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="MyLittleSlideShow" Classes="hint" />
      </StackPanel>
    </Grid>

    <!-- Fusszeile -->
    <Border DockPanel.Dock="Bottom"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource Fine.CardBorder}"
            Background="{DynamicResource Fine.CardBackground}"
            Padding="18,12,24,12">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <Button Grid.Column="0" Classes="donate" Padding="12,0" Height="28" Margin="0,0,8,0"
                Click="Donate_Click">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="heart" FontSize="17" />
            <TextBlock Classes="label" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="subtle" Content="{l:T 'Infos'}" Click="Info_Click" />
        <Button Grid.Column="3" Content="{l:T 'Abbrechen'}" Click="Cancel_Click"
                IsCancel="True" Margin="0,0,8,0" />
        <Button Grid.Column="4" Classes="primary" Content="{l:T 'Speichern'}" Click="Save_Click"
                IsDefault="True" MinWidth="96" />
      </Grid>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <!-- Zwei Spalten: halb so hoch wie untereinander, damit das Fenster
           auch auf einem Laptop (1920 x 1080, 125 %) bequem Platz hat. -->
      <Grid ColumnDefinitions="*,20,*" Margin="24,4,24,18">
        <StackPanel Grid.Column="0" Spacing="14">
          <!-- Sprache: wirkt sofort; "Abbrechen" stellt die vorige wieder her -->
          <StackPanel>
            <TextBlock Classes="section" Text="{l:T 'SPRACHE'}" />
            <Border Classes="card" Padding="14,10">
              <StackPanel Spacing="8">
                <ComboBox x:Name="Language_ComboBox" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="l:Language">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <v:FlagView Language="{Binding}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Classes="hint" VerticalAlignment="Center" TextWrapping="Wrap"
                             Text="{l:T 'Weitere Sprachen als Datei im Ordner languages'}" />
                  <Button Grid.Column="1" Classes="primary" Content="{l:T 'Beispieldatei erstellen'}"
                          Click="CreateSampleLanguage_Click" Margin="8,0,6,0" />
                  <Button Grid.Column="2" Classes="primary" Content="{l:T 'Ordner öffnen'}" Click="OpenLanguageFolder_Click" />
                </Grid>
                <TextBlock x:Name="LanguageHint" Classes="hint" TextWrapping="Wrap" IsVisible="False" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Allgemein -->
          <StackPanel>
            <TextBlock Classes="section" Text="{l:T 'ALLGEMEIN'}" />
            <Border Classes="card">
              <StackPanel>
                <Grid Classes="row">
                  <CheckBox x:Name="Autostart_CheckBox"
                            Content="{l:T 'Automatisch beim Anmelden starten'}" />
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row">
                  <CheckBox x:Name="DisplayAlwaysOn_CheckBox"
                            Content="{l:T 'Bildschirm nicht abschalten, solange die Diaschau läuft'}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Darstellung -->
          <StackPanel>
            <TextBlock Classes="section" Text="{l:T 'DARSTELLUNG'}" />
            <Border Classes="card">
              <StackPanel>
                <!-- Alle Regler wirken sofort als Vorschau im Hauptfenster. -->
                <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                  <CheckBox x:Name="Sharpen_CheckBox" Content="{l:T 'Bilder schärfen'}" />
                  <Slider Grid.Column="1" x:Name="SharpenValue_Slider" Minimum="0" Maximum="99"
                          ToolTip.Tip="{l:T 'Stärke 0–99 · Standard 25'}" />
                  <TextBlock Grid.Column="2" x:Name="SharpenValue_Label" Classes="value" />
                </Grid>
                <Border Classes="divider" />
                <!-- Hinweis bewusst ausserhalb des Grids: ein umbrechender Text in
                     der *-Spalte neben einer Auto-Spalte laesst die Zeile breiter
                     werden als die Karte. -->
                <Grid Classes="row" ColumnDefinitions="*,Auto,Auto" Margin="24,0,0,0">
                  <CheckBox x:Name="QuietSharpen_CheckBox" Content="{l:T 'Ruhiges Schärfen ab Schwelle'}" />
                  <Slider Grid.Column="1" x:Name="SharpenThreshold_Slider" Minimum="0" Maximum="64"
                          ToolTip.Tip="{l:T 'Schwelle 0–64 · Standard 6'}" />
                  <TextBlock Grid.Column="2" x:Name="SharpenThreshold_Label" Classes="value" />
                </Grid>
                <TextBlock Classes="hint" Margin="48,-8,0,9"
                           Text="{l:T 'Verstärkt kein Rauschen in glatten Flächen wie Himmel oder Haut.'}" />
                <Border Classes="divider" />
                <Grid Classes="row">
                  <StackPanel Margin="0,6">
                    <CheckBox x:Name="StretchWhileZooming_CheckBox" Content="{l:T 'Beim Zoomen mitstrecken'}" />
                    <TextBlock Classes="hint" Margin="24,3,0,0"
                               Text="{l:T 'Neu berechnet und geschärft wird erst, wenn das Mausrad steht.'}" />
                  </StackPanel>
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                  <CheckBox x:Name="AmbiFrame_CheckBox" Content="{l:T 'AmbiFrame anzeigen'}" />
                  <Slider Grid.Column="1" x:Name="AmbiFrameOpacity_Slider" Minimum="0" Maximum="99"
                          ToolTip.Tip="{l:T 'Deckkraft 0–99 · Standard 90'}" />
                  <TextBlock Grid.Column="2" x:Name="AmbiFrameOpacity_Label" Classes="value" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="14">
          <!-- Diaschau -->
          <StackPanel>
            <TextBlock Classes="section" Text="{l:T 'DIASCHAU'}" />
            <Border Classes="card">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                  <CheckBox x:Name="SlideShow_CheckBox" Content="{l:T 'Bilder automatisch wechseln'}" />
                  <Slider Grid.Column="1" x:Name="Interval_Slider" Minimum="0" Maximum="20"
                          LargeChange="3"
                          ToolTip.Tip="{l:T 'Zeit bis zum nächsten Bild, 5 Sekunden bis 24 Stunden'}" />
                  <TextBlock Grid.Column="2" x:Name="Interval_Label" Classes="value" />
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row">
                  <CheckBox x:Name="Random_CheckBox" Content="{l:T 'Zufällige Reihenfolge'}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Desktophintergrund -->
          <StackPanel>
            <TextBlock Classes="section" Text="{l:T 'DESKTOPHINTERGRUND'}" />
            <Border Classes="card">
              <StackPanel>
                <Grid Classes="row">
                  <CheckBox x:Name="EveryImageAsWallpaper_CheckBox"
                            Content="{l:T 'Jedes Bild beim Wechsel auch als Hintergrund setzen'}" />
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{l:T 'Anordnung'}" Margin="24,0,0,0" />
                  <ComboBox Grid.Column="1" x:Name="WallpaperStyle_ComboBox" Width="160" />
                </Grid>
                <TextBlock x:Name="WallpaperHint"
                           Classes="hint"
                           Foreground="{DynamicResource Fine.Warning}"
                           Margin="0,0,0,10"
                           IsVisible="False" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Bilderordner -->
          <StackPanel>
            <TextBlock Classes="section" Text="{l:T 'BILDERORDNER'}" />
            <Border Classes="card" Padding="14,12">
              <StackPanel Spacing="10">
                <Border Background="{DynamicResource Fine.Inset}"
                        BorderBrush="{DynamicResource Fine.Divider}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10,7">
                  <Grid ColumnDefinitions="Auto,*">
                    <Image Source="/Assets/Images/folder.png" Width="16" Height="16"
                           VerticalAlignment="Top" Margin="0,0,9,0"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock Grid.Column="1" x:Name="FolderPath_Label"
                               FontSize="11.5" TextWrapping="Wrap" />
                  </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto,Auto">
                  <CheckBox x:Name="Recursive_CheckBox" Content="{l:T 'Unterordner einbeziehen'}" />
                  <Button Grid.Column="1" Classes="subtle" Content="{l:T 'Zurücksetzen'}"
                          Click="ResetPath_Click" Margin="0,0,6,0" />
                  <Button Grid.Column="2" Content="{l:T 'Ordner wählen …'}" Click="SelectFolder_Click" />
                </Grid>

                <TextBlock Classes="hint"
                           Text="{l:T 'Unterstützte Formate: jpg, jpeg, png, gif, bmp, webp'}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
