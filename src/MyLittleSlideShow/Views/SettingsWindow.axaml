<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyLittleSlideShow.Views.SettingsWindow"
        Title="MyLittleSlideShow Einstellungen"
        Width="980"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontSize="12"
        Background="{DynamicResource Fine.WindowBackground}"
        Foreground="{DynamicResource Fine.TextPrimary}"
        Icon="/Assets/My_Icon.ico">

  <Window.Styles>
    <StyleInclude Source="/Themes/FineTheme.axaml" />

    <!-- In der schmaleren Spalte etwas kuerzere Regler -->
    <Style Selector="Slider">
      <Setter Property="Width" Value="130" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Kopfzeile -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="24,16,24,8">
      <Image Source="/Assets/Images/MyIcon.png" Width="30" Height="30"
             VerticalAlignment="Center"
             RenderOptions.BitmapInterpolationMode="HighQuality" />
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
        <TextBlock Text="Einstellungen" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="MyLittleSlideShow" Classes="hint" />
      </StackPanel>
    </Grid>

    <!-- Fusszeile -->
    <Border DockPanel.Dock="Bottom"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource Fine.CardBorder}"
            Background="{DynamicResource Fine.CardBackground}"
            Padding="18,12,24,12">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <Button Grid.Column="0" Classes="subtle" Content="Spenden" Click="Donate_Click" />
        <Button Grid.Column="1" Classes="subtle" Content="Infos" Click="Info_Click" />
        <Button Grid.Column="3" Content="Abbrechen" Click="Cancel_Click"
                IsCancel="True" Margin="0,0,8,0" />
        <Button Grid.Column="4" Classes="primary" Content="Speichern" Click="Save_Click"
                IsDefault="True" MinWidth="96" />
      </Grid>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <!-- Zwei Spalten: halb so hoch wie untereinander, damit das Fenster
           auch auf einem Laptop (1920 x 1080, 125 %) bequem Platz hat. -->
      <Grid ColumnDefinitions="*,20,*" Margin="24,4,24,18">
        <StackPanel Grid.Column="0" Spacing="14">
          <!-- Allgemein -->
          <StackPanel>
            <TextBlock Classes="section" Text="ALLGEMEIN" />
            <Border Classes="card">
              <StackPanel>
                <Grid Classes="row">
                  <CheckBox x:Name="Autostart_CheckBox"
                            Content="Automatisch beim Anmelden starten" />
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row">
                  <CheckBox x:Name="DisplayAlwaysOn_CheckBox"
                            Content="Bildschirm nicht abschalten, solange die Diaschau läuft" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Darstellung -->
          <StackPanel>
            <TextBlock Classes="section" Text="DARSTELLUNG" />
            <Border Classes="card">
              <StackPanel>
                <!-- Alle Regler wirken sofort als Vorschau im Hauptfenster. -->
                <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                  <CheckBox x:Name="Sharpen_CheckBox" Content="Bilder schärfen" />
                  <Slider Grid.Column="1" x:Name="SharpenValue_Slider" Minimum="0" Maximum="99"
                          ToolTip.Tip="Stärke 0–99 · Standard 25" />
                  <TextBlock Grid.Column="2" x:Name="SharpenValue_Label" Classes="value" />
                </Grid>
                <Border Classes="divider" />
                <!-- Hinweis bewusst ausserhalb des Grids: ein umbrechender Text in
                     der *-Spalte neben einer Auto-Spalte laesst die Zeile breiter
                     werden als die Karte. -->
                <Grid Classes="row" ColumnDefinitions="*,Auto,Auto" Margin="24,0,0,0">
                  <CheckBox x:Name="QuietSharpen_CheckBox" Content="Ruhiges Schärfen ab Schwelle" />
                  <Slider Grid.Column="1" x:Name="SharpenThreshold_Slider" Minimum="0" Maximum="64"
                          ToolTip.Tip="Schwelle 0–64 · Standard 6" />
                  <TextBlock Grid.Column="2" x:Name="SharpenThreshold_Label" Classes="value" />
                </Grid>
                <TextBlock Classes="hint" Margin="48,-8,0,9"
                           Text="Verstärkt kein Rauschen in glatten Flächen wie Himmel oder Haut." />
                <Border Classes="divider" />
                <Grid Classes="row">
                  <StackPanel Margin="0,6">
                    <CheckBox x:Name="StretchWhileZooming_CheckBox" Content="Beim Zoomen mitstrecken" />
                    <TextBlock Classes="hint" Margin="24,3,0,0"
                               Text="Neu berechnet und geschärft wird erst, wenn das Mausrad steht." />
                  </StackPanel>
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                  <CheckBox x:Name="AmbiFrame_CheckBox" Content="AmbiFrame anzeigen" />
                  <Slider Grid.Column="1" x:Name="AmbiFrameOpacity_Slider" Minimum="0" Maximum="99"
                          ToolTip.Tip="Deckkraft 0–99 · Standard 90" />
                  <TextBlock Grid.Column="2" x:Name="AmbiFrameOpacity_Label" Classes="value" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Spacing="14">
          <!-- Diaschau -->
          <StackPanel>
            <TextBlock Classes="section" Text="DIASCHAU" />
            <Border Classes="card">
              <StackPanel>
                <Grid Classes="row" ColumnDefinitions="*,Auto,Auto">
                  <CheckBox x:Name="SlideShow_CheckBox" Content="Bilder automatisch wechseln" />
                  <Slider Grid.Column="1" x:Name="Interval_Slider" Minimum="0" Maximum="20"
                          LargeChange="3"
                          ToolTip.Tip="Zeit bis zum nächsten Bild, 5 Sekunden bis 24 Stunden" />
                  <TextBlock Grid.Column="2" x:Name="Interval_Label" Classes="value" />
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row">
                  <CheckBox x:Name="Random_CheckBox" Content="Zufällige Reihenfolge" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Desktophintergrund -->
          <StackPanel>
            <TextBlock Classes="section" Text="DESKTOPHINTERGRUND" />
            <Border Classes="card">
              <StackPanel>
                <Grid Classes="row">
                  <CheckBox x:Name="EveryImageAsWallpaper_CheckBox"
                            Content="Jedes Bild beim Wechsel auch als Hintergrund setzen" />
                </Grid>
                <Border Classes="divider" />
                <Grid Classes="row" ColumnDefinitions="*,Auto">
                  <TextBlock Text="Anordnung" Margin="24,0,0,0" />
                  <ComboBox Grid.Column="1" x:Name="WallpaperStyle_ComboBox" Width="160" />
                </Grid>
                <TextBlock x:Name="WallpaperHint"
                           Classes="hint"
                           Foreground="{DynamicResource Fine.Warning}"
                           Margin="0,0,0,10"
                           IsVisible="False" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Bilderordner -->
          <StackPanel>
            <TextBlock Classes="section" Text="BILDERORDNER" />
            <Border Classes="card" Padding="14,12">
              <StackPanel Spacing="10">
                <Border Background="{DynamicResource Fine.Inset}"
                        BorderBrush="{DynamicResource Fine.Divider}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="10,7">
                  <Grid ColumnDefinitions="Auto,*">
                    <Image Source="/Assets/Images/folder.png" Width="16" Height="16"
                           VerticalAlignment="Top" Margin="0,0,9,0"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock Grid.Column="1" x:Name="FolderPath_Label"
                               FontSize="11.5" TextWrapping="Wrap" />
                  </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto,Auto">
                  <CheckBox x:Name="Recursive_CheckBox" Content="Unterordner einbeziehen" />
                  <Button Grid.Column="1" Classes="subtle" Content="Zurücksetzen"
                          Click="ResetPath_Click" Margin="0,0,6,0" />
                  <Button Grid.Column="2" Content="Ordner wählen …" Click="SelectFolder_Click" />
                </Grid>

                <TextBlock Classes="hint"
                           Text="Unterstützte Formate: jpg, jpeg, png, gif, bmp, webp" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
