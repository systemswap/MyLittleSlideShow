<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyLittleSlideShow.Views.InfoWindow"
        Title="Dateiinfos"
        Width="420" Height="460"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Icon="/Assets/My_Icon.ico">

  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Verzeichnis öffnen" Click="OpenDirectory_Click" />
      <Button Content="Schließen" Click="Close_Click" IsCancel="True" />
    </StackPanel>

    <ListBox x:Name="InfoLB" SelectionMode="Single">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="6,2" />
          <Setter Property="MinHeight" Value="0" />
        </Style>
      </ListBox.Styles>
    </ListBox>
  </DockPanel>
</Window>
