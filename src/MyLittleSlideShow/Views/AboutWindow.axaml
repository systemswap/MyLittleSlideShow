<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyLittleSlideShow.Views.AboutWindow"
        Title="Infos"
        Width="460" Height="480"
        WindowStartupLocation="CenterOwner"
        FontSize="12"
        Background="{DynamicResource Fine.WindowBackground}"
        Foreground="{DynamicResource Fine.TextPrimary}"
        Icon="/Assets/My_Icon.ico">

  <Window.Styles>
    <StyleInclude Source="/Themes/FineTheme.axaml" />

    <!-- Reiter als kleine, nebeneinander stehende Felder: dezent grau hinterlegt,
         der gewaehlte in der Akzentfarbe. Fluents Reiter haben 24 pt grosse
         Ueberschriften und brechen in diesem schmalen Fenster um. -->
    <Style Selector="TabItem">
      <Setter Property="Theme">
        <ControlTheme TargetType="TabItem">
          <Setter Property="FontSize" Value="12" />
          <Setter Property="Foreground" Value="{DynamicResource Fine.TextSecondary}" />
          <Setter Property="Background" Value="{DynamicResource Fine.CardBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Fine.CardBorder}" />
          <Setter Property="Cursor" Value="Hand" />
          <Setter Property="Margin" Value="0,0,6,0" />
          <Setter Property="Template">
            <ControlTemplate>
              <Border x:Name="Tab"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="5"
                      Padding="12,4,12,5">
                <ContentPresenter Content="{TemplateBinding Header}"
                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                  Foreground="{TemplateBinding Foreground}" />
              </Border>
            </ControlTemplate>
          </Setter>

          <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource Fine.SubtleHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Fine.TextPrimary}" />
          </Style>
          <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource Fine.Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Fine.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Fine.OnAccent}" />
          </Style>
          <Style Selector="^:focus-visible /template/ Border#Tab">
            <Setter Property="BorderBrush" Value="{DynamicResource Fine.AccentHover}" />
          </Style>
        </ControlTheme>
      </Setter>
    </Style>

    <!-- Textzeilen dicht untereinander; lange Zeilen brechen um statt rechts
         abgeschnitten zu werden -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ItemTemplate">
        <DataTemplate x:DataType="x:String">
          <TextBlock Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="10,1" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Fusszeile -->
    <Border DockPanel.Dock="Bottom"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource Fine.CardBorder}"
            Background="{DynamicResource Fine.CardBackground}"
            Padding="18,10,18,10">
      <Button Classes="primary" Content="Schließen" HorizontalAlignment="Right"
              Click="Close_Click" IsCancel="True" IsDefault="True" MinWidth="96" />
    </Border>

    <TabControl Padding="0" Margin="14,14,14,14">
      <TabControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10" />
        </ItemsPanelTemplate>
      </TabControl.ItemsPanel>
      <TabItem Header="Versteckte Optionen">
        <Border Classes="card" Padding="0,6">
          <ListBox x:Name="HiddenOptions" />
        </Border>
      </TabItem>
      <TabItem Header="Changelog">
        <Border Classes="card" Padding="0,6">
          <ListBox x:Name="ChangeLogText_ListBox" />
        </Border>
      </TabItem>
      <TabItem Header="Lizenzen">
        <Border Classes="card" Padding="0,6">
          <ListBox x:Name="Licenses_ListBox" />
        </Border>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
