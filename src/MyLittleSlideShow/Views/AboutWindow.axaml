<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyLittleSlideShow.Views.AboutWindow"
        Title="Infos"
        Width="460" Height="480"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/My_Icon.ico">

  <DockPanel Margin="10">
    <Button DockPanel.Dock="Bottom" Content="Schließen" HorizontalAlignment="Right"
            Margin="0,10,0,0" Click="Close_Click" IsCancel="True" />

    <TabControl>
      <TabItem Header="Versteckte Optionen">
        <ListBox x:Name="HiddenOptions" />
      </TabItem>
      <TabItem Header="Changelog">
        <ListBox x:Name="ChangeLogText_ListBox" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
